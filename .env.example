# Required: scrypt hash of your login password. Create it with: node scripts/hash-password.ts
OFFERLOG_PASSWORD_HASH=

# Optional: enables the AI bullet-point rewrite on the resume tailor page.
ANTHROPIC_API_KEY=

# Optional: where the SQLite file lives (default ./data/offerlog.db; /data/offerlog.db in Docker).
# OFFERLOG_DB=./data/offerlog.db

# Optional: force the Secure cookie flag when TLS terminates somewhere that does not send X-Forwarded-Proto.
# OFFERLOG_SECURE_COOKIE=true
