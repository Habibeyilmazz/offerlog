{
  "name": "offerlog",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted job-search command center: kanban, timeline, interview prep, resume keyword gaps and funnel analytics.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 4220",
    "build": "next build",
    "start": "next start -p 4220",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:seed": "node scripts/seed.ts",
    "hash-password": "node scripts/hash-password.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "next": "16.4.5",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "drizzle-kit": "0.31.11",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
